# =============================================================================
# Market Watch — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values.
#
#   cp .env.example .env.local
#
# Only variables prefixed with VITE_ are exposed to the browser. Everything
# else must stay server-side (Supabase Edge Functions / your own backend) and
# must never be committed or shipped to the client.
#
# Never put real keys in THIS file — it is tracked by git. Real values belong
# in `.env.local`, which is gitignored.
#
# The app runs in DEMO MODE (sample data, no login) when the Clerk and
# Supabase values below are empty, so you can always preview the UI.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. CLERK — login, sign-up and user management   https://dashboard.clerk.com
# -----------------------------------------------------------------------------
# Create an application, then: API Keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Keys → Secret key. SERVER ONLY — never expose this in the browser.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend API / Issuer URL, found under "Domains" (or "API Keys → Advanced").
# Paste this exact URL into Supabase → Authentication → Third-party auth → Clerk
# so Supabase can verify Clerk session tokens. Example:
#   https://your-app-name.clerk.accounts.dev
CLERK_JWT_ISSUER=https://your-app-name.clerk.accounts.dev


# -----------------------------------------------------------------------------
# 2. SUPABASE — Postgres database, storage and file uploads
#    https://supabase.com/dashboard → your project → Settings → API
# -----------------------------------------------------------------------------
# Settings → API → Project URL. Must be the HTTPS endpoint — supabase-js
# cannot use the "postgresql://..." connection string shown in Connect.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Settings → API → service_role key. SERVER ONLY. Used by scheduled jobs that
# pull supplier/competitor pages and write results. It bypasses row level
# security, so it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Settings → General → Reference ID (needed by the Supabase CLI for migrations)
SUPABASE_PROJECT_REF=your-project-ref

# -----------------------------------------------------------------------------
# 3. APP
# -----------------------------------------------------------------------------
# Where the app is served — used for links back from emails.
VITE_APP_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# 4. OPTIONAL — scheduled scanning / email delivery
# -----------------------------------------------------------------------------
# Key that authorises the scheduled ingestion job (supplier + competitor scans).
SCAN_JOB_SECRET=replace-with-a-long-random-string

# Transactional email, used when the client message schedule actually sends.
# Any SMTP/API provider works — e.g. an API key from your email provider.
EMAIL_FROM=watch@yourretailbrand.com
EMAIL_API_KEY=
